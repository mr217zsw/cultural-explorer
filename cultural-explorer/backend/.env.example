# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.xxx:password@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:password@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="change-me-to-a-random-string"

# DeepSeek AI
DEEPSEEK_API_KEY="sk-xxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 通义万相（百炼）- 文生图 + TTS
DASHSCOPE_API_KEY="sk-ws-xxx"
BAILIAN_IMAGE_MODEL=wanx-v1
BAILIAN_TTS_MODEL=sambert-zhichu-v1

# Upstash Redis (可选)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# CST Object Storage (可选)
CST_ACCESS_KEY="xxx"
CST_SECRET_KEY="xxx"
CST_ENDPOINT="https://s3.cstcloud.cn"
CST_BUCKET="xxx"
CST_REGION="cn-north-1"

# Server
PORT=3000
NODE_ENV=development
